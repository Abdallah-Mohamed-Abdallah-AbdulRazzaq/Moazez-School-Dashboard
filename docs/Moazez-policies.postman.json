                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"academicYearId\": \"{{academicYearId}}\",\n  \"termId\": \"{{termId}}\",\n  \"nameAr\": \"سياسة الحضور الافتراضية\",\n  \"nameEn\": \"Default Attendance Policy\",\n  \"descriptionAr\": \"السياسة الافتراضية للحضور\",\n  \"descriptionEn\": \"Default attendance policy\",\n  \"notes\": null,\n  \"notesAr\": null,\n  \"notesEn\": null,\n  \"scopeType\": \"CLASSROOM\",\n  \"scopeIds\": {\n    \"classroomId\": \"{{classroomId}}\"\n  },\n  \"classroomId\": \"{{classroomId}}\",\n  \"mode\": \"PERIOD\",\n  \"dailyComputationStrategy\": \"DERIVED_FROM_PERIODS\",\n  \"selectedPeriodIds\": [\n    \"{{periodId}}\"\n  ],\n  \"lateThresholdMinutes\": 15,\n  \"earlyLeaveThresholdMinutes\": 15,\n  \"autoAbsentAfterMinutes\": null,\n  \"absentIfMissedPeriodsCount\": 2,\n  \"requireExcuseAttachment\": true,\n  \"requireAttachmentForExcuse\": true,\n  \"requireExcuseReason\": true,\n  \"allowParentExcuseRequests\": true,\n  \"allowExcuses\": true,\n  \"notifyGuardiansOnAbsence\": true,\n  \"notifyTeachers\": true,\n  \"notifyStudents\": false,\n  \"notifyGuardians\": true,\n  \"notifyOnAbsent\": true,\n  \"notifyOnLate\": true,\n  \"notifyOnEarlyLeave\": false,\n  \"effectiveFrom\": \"{{dateFrom}}\",\n  \"effectiveStartDate\": \"{{dateFrom}}\",\n  \"effectiveTo\": \"{{dateTo}}\",\n  \"effectiveEndDate\": \"{{dateTo}}\",\n  \"isActive\": true\n}",
