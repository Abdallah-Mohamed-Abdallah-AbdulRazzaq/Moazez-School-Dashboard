NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_REALTIME_URL=

# Leave empty first to use default Socket.IO path: /socket.io
# If backend mounts Socket.IO under API path, set:
# NEXT_PUBLIC_REALTIME_SOCKET_PATH=/api/v1/realtime/socket.io
NEXT_PUBLIC_REALTIME_SOCKET_PATH=

NEXT_PUBLIC_REALTIME_DEBUG=false

# Public store URLs for role-specific mobile apps. Leave a URL blank to disable its badge.
NEXT_PUBLIC_MOBILE_APP_STUDENT_GOOGLE_PLAY_URL=
NEXT_PUBLIC_MOBILE_APP_STUDENT_APP_STORE_URL=
NEXT_PUBLIC_MOBILE_APP_TEACHER_GOOGLE_PLAY_URL=
NEXT_PUBLIC_MOBILE_APP_TEACHER_APP_STORE_URL=
NEXT_PUBLIC_MOBILE_APP_PARENT_GOOGLE_PLAY_URL=
NEXT_PUBLIC_MOBILE_APP_PARENT_APP_STORE_URL=
NEXT_PUBLIC_MOBILE_APP_DISMISSAL_STAFF_GOOGLE_PLAY_URL=
NEXT_PUBLIC_MOBILE_APP_DISMISSAL_STAFF_APP_STORE_URL=

# These adapters are opt-in until their synchronous compatibility methods are implemented.
