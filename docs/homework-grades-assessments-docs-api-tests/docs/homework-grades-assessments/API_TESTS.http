GET {{baseUrl}}/teacher/classroom/{{classId}}/grades/assessments
Authorization: Bearer {{teacherToken}}

###
GET {{baseUrl}}/teacher/classroom/{{classId}}/grades/assessments/{{assessmentId}}
Authorization: Bearer {{teacherToken}}

###
GET {{baseUrl}}/teacher/classroom/{{classId}}/grades/gradebook
Authorization: Bearer {{teacherToken}}

### These should remain absent / not supported in V1
PUT {{baseUrl}}/teacher/classroom/{{classId}}/grades/assessments/{{assessmentId}}/items/{{studentId}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "score": 90
}

### -------------------------------------------------------------------------
### Student App Homework / Grades
### -------------------------------------------------------------------------

GET {{baseUrl}}/student/homeworks
Authorization: Bearer {{studentToken}}

###
GET {{baseUrl}}/student/homeworks/{{homeworkId}}
Authorization: Bearer {{studentToken}}

### Save submission draft - adjust body to DTO
PUT {{baseUrl}}/student/homeworks/{{homeworkId}}/submission
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "notes": "Draft answer"
}

### Submit homework - adjust body to DTO
POST {{baseUrl}}/student/homeworks/{{homeworkId}}/submit
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "notes": "Final submission"
}

### Grades
GET {{baseUrl}}/student/grades
Authorization: Bearer {{studentToken}}

###
GET {{baseUrl}}/student/grades/summary
Authorization: Bearer {{studentToken}}

###
